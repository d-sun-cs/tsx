+static void prepare_input(bufferlist& in, int size, const string& pattern,
+                          std::uint32_t seed)
+{
+  string data(size, 'X');
+  if (pattern == "random") {
+    // Input preparation is outside the timed loop. Taking the low byte of
+    // mt19937 output avoids implementation-dependent distribution mappings.
+    std::mt19937 rng(seed);
+    for (char& byte : data) {
+      byte = static_cast<char>(rng() & 0xff);
+    }
+  }
+  in.append(data);
+  in.rebuild_aligned(ErasureCode::SIMD_ALIGN);
+}
