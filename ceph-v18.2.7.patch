+int ErasureCodeBench::decode_once(const map<int,bufferlist>& all_chunks,
+                                  const map<int,bufferlist>& chunks,
+                                  const set<int>& want,
+                                  ErasureCodeInterfaceRef erasure_code,
+                                  bool check)
+{
+  set<int> erased_targets;
+  if (decode_only_erased) {
+    for (const auto& chunk : all_chunks) {
+      if (!chunks.count(chunk.first)) {
+        erased_targets.insert(chunk.first);
+      }
+    }
+  }
+  const auto& targets = decode_only_erased ? erased_targets : want;
+  map<int,bufferlist> selected;
+  const auto* inputs = &chunks;
+  if (use_minimum) {
+    set<int> available;
+    for (const auto& chunk : chunks) {
+      available.insert(chunk.first);
+    }
+    map<int, vector<std::pair<int, int>>> minimum;
+    int r = erasure_code->minimum_to_decode(targets, available, &minimum);
+    if (r) {
+      cerr << "minimum_to_decode failed: " << r << endl;
+      return r;
+    }
+    for (const auto& entry : minimum) {
+      auto chunk = chunks.find(entry.first);
+      if (chunk == chunks.end()) {
+        cerr << "minimum_to_decode selected an unavailable shard" << endl;
+        return -EINVAL;
+      }
+      // This benchmark supplies whole shards, even if fewer subchunks suffice.
+      selected.emplace(chunk->first, chunk->second);
+    }
+    inputs = &selected;
+  }
+  if (verbose) {
+    cout << "decode want=";
+    for (int id : targets) {
+      cout << id << ',';
+    }
+    cout << " helpers=";
+    uint64_t bytes = 0;
+    for (const auto& chunk : *inputs) {
+      cout << chunk.first << ',';
+      bytes += chunk.second.length();
+    }
+    cout << " helper_count=" << inputs->size() << " helper_bytes=" << bytes << endl;
+  }
+  map<int,bufferlist> decoded;
+  int r = erasure_code->decode(targets, *inputs, &decoded, 0);
+  if (r) {
+    cerr << "decode failed: " << r << endl;
+    return r;
+  }
+  if (check) {
+    for (int id : targets) {
+      auto expected_chunk = all_chunks.find(id);
+      auto actual_chunk = decoded.find(id);
+      if (expected_chunk == all_chunks.end() || actual_chunk == decoded.end() ||
+          expected_chunk->second.length() != actual_chunk->second.length()) {
+        cerr << "chunk " << id << " missing or decoded with incorrect length" << endl;
+        return -EIO;
+      }
+      if (!expected_chunk->second.contents_equal(actual_chunk->second)) {
+        const string expected = expected_chunk->second.to_str();
+        const string actual = actual_chunk->second.to_str();
+        auto mismatch = std::mismatch(expected.begin(), expected.end(), actual.begin());
+        cerr << "chunk " << id
+             << " content and recovered content are different at byte "
+             << (mismatch.first - expected.begin()) << endl;
+        return -EIO;
+      }
+    }
+  }
+  return 0;
+}
